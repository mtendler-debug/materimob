# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase.
# Só valores públicos ficam aqui — a chave service_role NUNCA entra neste arquivo
# nem em nenhuma variável do Netlify.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Medição de campanhas (opcional; valores públicos). Sem eles o site funciona
# igual, só não mede. Ver src/lib/medicao.js.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
